{
  "name": "local-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "description": "Desktop code editor with project chat and inline AI edits.",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview --noSandbox",
    "test:unit": "node --test tests/core/*.test.js tests/main/*.test.js",
    "test:e2e": "electron-vite build && node --test --test-concurrency=1 tests/e2e/*.test.js",
    "test": "node --test tests/core/*.test.js tests/main/*.test.js && electron-vite build && node --test --test-concurrency=1 tests/e2e/*.test.js"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.65.0",
    "vite": "^8.3.6"
  }
}
